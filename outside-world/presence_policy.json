{
  "schema": "the-world-external-presence-policy/v1",
  "principle": "LIMITLESS_MIND_BOUNDED_EXECUTION",
  "default_mode": "PROACTIVE",
  "mission_interval_minutes": 10,
  "identity": {
    "one_presence_profile_per_citizen": true,
    "credential_model": "secret_reference_only",
    "store_passwords_in_repository": false,
    "impersonation": false,
    "real_person_identity_claims": false
  },
  "automatic_read_actions": [
    "read_public",
    "search_public",
    "watch_public",
    "collect_public_metadata",
    "inspect_public_repository",
    "read_authorized_connector"
  ],
  "write_actions": [
    "post",
    "comment",
    "react",
    "send_message",
    "publish_artifact"
  ],
  "account_actions": ["create_account"],
  "blocked_signals": [
    "access_control_bypass",
    "rate_limit_evasion",
    "secret_extraction",
    "deceptive_identity",
    "bulk_unsolicited",
    "harassment",
    "destructive_action"
  ],
  "write_gate": {
    "require_terms_status": "allowed",
    "require_connector_authorized": true,
    "require_identity_non_deceptive": true,
    "require_target_scope": "authorized",
    "auto_requires_reversible": true,
    "default_when_adapter_missing": "DRAFT_ONLY"
  },
  "account_creation": {
    "mode": "CONNECTOR_APPROVED_ONLY",
    "approved_services": [],
    "require_terms_status": "allowed",
    "require_connector_authorized": true,
    "require_secret_manager": true,
    "default_decision": "DRAFT_ONLY"
  },
  "mission_lanes": [
    {
      "id": "PUBLIC_WEB",
      "action": "search_public",
      "objective": "Find a new public fact, tool, problem, opportunity, or cultural signal and return evidence."
    },
    {
      "id": "PUBLIC_YOUTUBE",
      "action": "watch_public",
      "objective": "Inspect public YouTube videos/channels relevant to the assigned curiosity and return useful timestamps, claims, or ideas."
    },
    {
      "id": "PUBLIC_GITHUB",
      "action": "inspect_public_repository",
      "objective": "Explore public repositories, issues, releases, or engineering discussions and return reusable technical patterns."
    },
    {
      "id": "PUBLIC_RESEARCH",
      "action": "search_public",
      "objective": "Explore public papers, blogs, benchmarks, and primary sources; challenge one assumption with evidence."
    },
    {
      "id": "PUBLIC_BUILDERS",
      "action": "search_public",
      "objective": "Explore public builder communities and small experiments; bring back one surprising implementation or unmet need."
    }
  ],
  "mission_rules": {
    "all_discovered_citizens_receive_a_mission": true,
    "rotate_lanes_by_cycle_seed": true,
    "no_external_write_generated_by_default": true,
    "evidence_required": true,
    "respect_platform_rate_limits": true
  },
  "dispatch": {
    "optional_webhook_env": "WORLD_EXTERNAL_PRESENCE_WEBHOOK_URL",
    "slack_summary_env": "RND_SLACK_WEBHOOK_URL",
    "payload_contains_credentials": false
  }
}
