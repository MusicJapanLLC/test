{
  "schema": "the-world-external-write-targets/v1",
  "mode": "ROTATING_ALLOWLIST",
  "max_total_writes_per_run": 5,
  "dedupe_hours": 72,
  "principle": "EXPLORE_WIDELY_WRITE_THROUGH_AUTHORIZED_ACCOUNTS",
  "platforms": [
    {
      "id": "github-issues",
      "kind": "github_issue",
      "enabled": true,
      "repo": "MusicJapanLLC/test",
      "required_env": ["GITHUB_TOKEN"],
      "max_per_day": 8,
      "labels": ["the-world", "automated"],
      "note": "Uses GITHUB_TOKEN — always available in Actions, no new secret needed"
    },
    {
      "id": "discord",
      "kind": "discord_webhook",
      "enabled": true,
      "required_env": ["DISCORD_WEBHOOK_URL"],
      "max_per_day": 8,
      "note": "Discord incoming webhook — set DISCORD_WEBHOOK_URL secret in repo settings"
    },
    {
      "id": "slack",
      "kind": "slack_webhook",
      "enabled": true,
      "required_env": ["SLACK_WEBHOOK_URL"],
      "max_per_day": 8,
      "max_chars": 2800,
      "note": "Slack incoming webhook — set SLACK_WEBHOOK_URL secret in repo settings"
    },
    {
      "id": "dev-community",
      "kind": "devto",
      "enabled": true,
      "endpoint": "https://dev.to/api/articles",
      "required_env": ["DEVTO_API_KEY"],
      "max_per_day": 2,
      "tags": ["ai", "research"]
    },
    {
      "id": "mastodon",
      "kind": "mastodon",
      "enabled": true,
      "required_env": ["MASTODON_BASE_URL", "MASTODON_ACCESS_TOKEN"],
      "max_per_day": 8,
      "max_chars": 480
    },
    {
      "id": "bluesky",
      "kind": "bluesky",
      "enabled": true,
      "required_env": ["BLUESKY_HANDLE", "BLUESKY_APP_PASSWORD"],
      "max_per_day": 8,
      "max_chars": 280
    },
    {
      "id": "wordpress",
      "kind": "wordpress",
      "enabled": true,
      "required_env": ["WORDPRESS_BASE_URL", "WORDPRESS_USERNAME", "WORDPRESS_APP_PASSWORD"],
      "max_per_day": 2,
      "status": "publish"
    }
  ]
}
