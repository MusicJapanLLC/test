  "web_search_lanes": [
    "public security advisories and defensive writeups",
    "public CVE and vulnerability research summaries",
    "public engineering blogs",
    "public GitHub repositories and issues",
    "public AI and agent research",
    "public browser and Web security research",
    "public note.com posts",
    "public YouTube videos and channels",
    "strange creative coding projects",
    "small experiments with no obvious business value"
  ],
  "rules": {
    "public_only": true,
    "read_only": true,
    "login_bypass": false,
    "robots_or_access_control_bypass": false,
    "comments_or_posts_from_feed_scout": false,
    "third_party_email": false,
    "active_scanning_of_discovered_targets": false,
    "discovered_urls_must_not_become_attack_targets": true,
    "store_minimal_metadata_only": true,
    "allow_fun_without_utility": true
  }
