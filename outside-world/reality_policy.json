{
  "schema": "the-world-reality-policy/v1",
  "mode": "active_bounded_autonomy",
  "faith": "LIMITLESS",
  "posture": "DEFAULT_ACT",
  "guard_posture": "ALLOWLISTED_LOW_RISK_AUTO_NO_FRESH_APPROVAL",
  "pulse": {
    "target_seconds": 60,
    "github_watchdog_minutes": 5,
    "max_citizens_per_pulse": 24,
    "max_observations_per_pulse": 24,
    "max_publications_per_pulse": 2,
    "owned_publication_interval_hours": 6,
    "owned_publication_daily_cap": 8
  },
  "autonomy_tiers": {
    "T0_OBSERVE": "AUTO",
    "T1_ORGANIZE": "AUTO",
    "T2_PUBLISH_OWNED_OR_AUTHORIZED": "AUTO_WHEN_AUTHORIZED_REVERSIBLE_PLATFORM_PERMITTED",
    "T3_PREAUTHORIZED_BUSINESS_CONTACT": "AUTO_INSIDE_APPROVED_ENVELOPE",
    "T4_MATERIAL_COMMITMENT": "EXPLICIT_APPROVAL"
  },
  "actions": {
    "public_web_observe": "AUTO",
    "public_feed_observe": "AUTO",
    "youtube_public_observe": "AUTO",
    "research_synthesize": "AUTO",
    "draft_external_post": "AUTO",
    "artifact_generate": "AUTO",
    "artifact_upload_owned_runtime": "AUTO",
    "github_issue_own_repo": "AUTO_ALLOWLIST",
    "github_issue_comment_own_repo": "AUTO_ALLOWLIST",
    "slack_post_owned_workspace": "AUTO_ALLOWLIST",
    "external_post_allowlisted_account": "AUTO_ALLOWLIST",
    "gmail_read": "AUTO_WITH_EXISTING_OAUTH",
    "gmail_label": "AUTO_WITH_EXISTING_RULES",
    "gmail_archive": "AUTO_WITH_EXISTING_RULES",
    "gmail_draft": "AUTO",
    "gmail_send": "PREAUTHORIZED_ENVELOPE_OR_APPROVAL",
    "general_external_post": "APPROVAL",
    "new_service_identity": "SERVICE_PERMITTED_AND_APPROVED",
    "purchase_or_payment": "APPROVAL",
    "contract_or_legal_commitment": "APPROVAL"
  },
  "allowlists": {
    "github_repositories": [
      "MusicJapanLLC/test"
    ],
    "slack_webhook_secret_names": [
      "RND_SLACK_WEBHOOK_URL",
      "CEO_REPORT_WEBHOOK_URL"
    ],
    "external_write_target_ids": [
      "github-issues",
      "github-issue-comments",
      "dev-community",
      "mastodon",
      "bluesky",
      "wordpress"
    ],
    "public_browser_hosts": [
      "github.com",
      "github.blog",
      "news.ycombinator.com",
      "hnrss.org",
      "dev.to",
      "arxiv.org",
      "export.arxiv.org",
      "youtube.com",
      "www.youtube.com",
      "note.com"
    ]
  },
  "identity": {
    "logical_identity_per_citizen": true,
    "credentials": "secret_reference_only",
    "human_identity_impersonation": false,
    "service_identity_creation": "provider_supported_only"
  },
  "browser": {
    "authenticated_sessions": "explicit_capability_required",
    "respect_service_limits": true,
    "respect_access_controls": true,
    "engagement_manipulation": false,
    "bulk_unsolicited_messaging": false,
    "fallback_on_block": "record_exact_blocker_then_continue_other_legitimate_lane"
  },
  "logging": {
    "record_every_effect": true,
    "record_fields": [
      "citizen_id",
      "action",
      "target",
      "decision",
      "timestamp",
      "result_id"
    ],
    "store_secrets": false,
    "store_private_message_body_in_artifacts": false
  }
}
