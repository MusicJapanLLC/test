# ─────────────────────────────────────────────────────────────
# MJ STORE 環境変数
# ローカルは .env.local に、本番は Vercel の Environment Variables に設定する
# VITE_ で始まる変数はビルド時に埋め込まれる（＝公開情報）。秘密の値は置かないこと
# ─────────────────────────────────────────────────────────────

# ご要望フォームの送信先（gas/Code.gs をウェブアプリとしてデプロイした URL）
# 例: https://script.google.com/macros/s/AKfycb...../exec
VITE_GAS_ENDPOINT=

# 本番の URL。canonical・OGP・sitemap・構造化データ・llms.txt の基準になる
# 未設定なら src/data/site.ts の url（https://store.music-japan.com）を使う
VITE_SITE_URL=

# 1 にすると、ご要望フォームは送信せずに完了画面だけ出す（プレビュー用）
VITE_DEMO=
