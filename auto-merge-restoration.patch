           if [[ -n "$PR_URL" ]]; then
             printf '\nPR: %s\n' "$PR_URL" >> /tmp/tomoki-forge-report.md
+            PR_NUMBER=$(echo "$PR_URL" | grep -oE '[0-9]+$')
