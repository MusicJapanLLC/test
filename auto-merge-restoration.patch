@@ -0,0 +1,126 @@
+name: AI PR Approval Gate
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened, ready_for_review]
+  workflow_dispatch:
+    inputs:
+      pr_number:
+        description: 'PR number to evaluate'
+        required: false
+        type: string
+
+permissions:
+  contents: read
+  pull-requests: write
+  checks: read
+
+jobs:
+  evaluate-and-label:
+    runs-on: ubuntu-latest
+    timeout-minutes: 8
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Setup Python
+        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
+        with:
+          python-version: '3.12'
+
+      - name: Evaluate PR for auto-merge eligibility
+        id: evaluate
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GITHUB_TOKEN: ${{ github.token }}
+          PR_NUMBER: ${{ github.event.pull_request.number || inputs.pr_number }}
+        run: |
+          set -euo pipefail
+
+          if [[ -z "$PR_NUMBER" ]]; then
+            echo "No PR number available"
+            exit 0
+          fi
+
+          echo "Evaluating PR #${PR_NUMBER}"
+
+          # Get PR details
+          PR_JSON=$(gh pr view "$PR_NUMBER" --json number,title,author,labels,isDraft,mergeable,reviewDecision,statusCheckRollup)
+
+          # Extract fields
+          IS_DRAFT=$(echo "$PR_JSON" | python -c "import sys,json; print(json.load(sys.stdin).get('isDraft', False))")
+          AUTHOR=$(echo "$PR_JSON" | python -c "import sys,json; print(json.load(sys.stdin).get('author', {}).get('login', ''))")
+          MERGEABLE=$(echo "$PR_JSON" | python -c "import sys,json; print(json.load(sys.stdin).get('mergeable', 'UNKNOWN'))")
+
+          # Check if already labeled
+          HAS_LABEL=$(echo "$PR_JSON" | python -c "import sys,json; labels=[l['name'] for l in json.load(sys.stdin).get('labels', [])]; print('true' if 'ai-merge-approved' in labels else 'false')")
+
+          if [[ "$HAS_LABEL" == "true" ]]; then
+            echo "PR #${PR_NUMBER} already has ai-merge-approved label"
+            echo "approved=already" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          # Eligibility criteria
+          ELIGIBLE=true
+          REASON=""
+
+          if [[ "$IS_DRAFT" == "True" ]]; then
+            ELIGIBLE=false
+            REASON="Draft PR"
+          elif [[ "$MERGEABLE" == "CONFLICTING" ]]; then
+            ELIGIBLE=false
+            REASON="Has merge conflicts"
+          elif [[ -z "$AUTHOR" ]]; then
+            ELIGIBLE=false
+            REASON="No author detected"
+          fi
+
+          # Check for trusted bot authors
+          TRUSTED_BOTS="ai-foundry-executor ai-foundry-repo-engineer TOMOKI-FORGE THE-WORLD-Agent-Factory github-actions dependabot"
+          IS_TRUSTED=false
+          for bot in $TRUSTED_BOTS; do
+            if [[ "$AUTHOR" == *"$bot"* ]] || [[ "$AUTHOR" == "$bot[bot]" ]]; then
+              IS_TRUSTED=true
+              break
+            fi
+          done
+
+          # Check PR title patterns for autonomous workflows
+          TITLE=$(echo "$PR_JSON" | python -c "import sys,json; print(json.load(sys.stdin).get('title', ''))")
+          if [[ "$TITLE" =~ ^(foundry|agent-factory|TOMOKI/FORGE|THE\ WORLD) ]]; then
+            IS_TRUSTED=true
+          fi
+
+          if [[ "$ELIGIBLE" == "true" ]] && [[ "$IS_TRUSTED" == "true" ]]; then
+            echo "approved=true" >> "$GITHUB_OUTPUT"
+            echo "reason=Trusted autonomous workflow PR" >> "$GITHUB_OUTPUT"
+          else
+            echo "approved=false" >> "$GITHUB_OUTPUT"
+            echo "reason=${REASON:-Not from trusted autonomous workflow}" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Add ai-merge-approved label
+        if: steps.evaluate.outputs.approved == 'true'
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PR_NUMBER: ${{ github.event.pull_request.number || inputs.pr_number }}
+        run: |
+          gh pr edit "$PR_NUMBER" --add-label "ai-merge-approved"
+          echo "✅ Added ai-merge-approved label to PR #${PR_NUMBER}"
+          echo "Reason: ${{ steps.evaluate.outputs.reason }}"
+
+      - name: Log evaluation result
+        if: always()
+        env:
+          PR_NUMBER: ${{ github.event.pull_request.number || inputs.pr_number }}
+          APPROVED: ${{ steps.evaluate.outputs.approved }}
+          REASON: ${{ steps.evaluate.outputs.reason }}
+        run: |
+          echo "### AI PR Approval Gate Result" >> "$GITHUB_STEP_SUMMARY"
+          echo "- PR: #${PR_NUMBER}" >> "$GITHUB_STEP_SUMMARY"
+          echo "- Approved: ${APPROVED:-N/A}" >> "$GITHUB_STEP_SUMMARY"
+          echo "- Reason: ${REASON:-N/A}" >> "$GITHUB_STEP_SUMMARY"
