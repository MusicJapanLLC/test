{
  "schema": "the-world-autonomy-policy/v2",
  "name": "THE WORLD high-autonomy operating policy",
  "autonomy_level": 98,
  "intent": "Maximize observation, experimentation, cross-system learning, self-improvement, autonomous branch work and machine-approved merges. Human approval is reserved for hard production and trust-boundary changes.",
  "capability_budget": {
    "repository_observation": 100,
    "public_read_only_external_research": 100,
    "local_experimentation": 100,
    "cross_system_learning": 100,
    "autonomous_branch_changes": 98,
    "self_improvement_after_tests": 98,
    "pull_request_generation": 100,
    "machine_approval_for_bounded_changes": 98,
    "default_branch_low_risk_merges": 95,
    "owned_allowlisted_security_research": 95,
    "production_release": 10
  },
  "autonomy_tiers": {
    "tier_0_observe": {
      "human_approval": false,
      "auto_execute": true,
      "scope": ["repository_read", "public_read_only_web", "logs", "artifacts", "metrics", "research_feeds"]
    },
    "tier_1_experiment": {
      "human_approval": false,
      "auto_execute": true,
      "scope": ["sandbox", "simulation", "shadow_league", "local_tests", "owned_test_fixtures", "research_generation"]
    },
    "tier_2_change": {
      "human_approval": false,
      "auto_execute": true,
      "auto_pr": true,
      "auto_merge_when_machine_verified": true,
      "scope": ["non_production_code", "docs", "tests", "generated_labs", "learning_state", "bounded_automation"]
    },
    "tier_3_owned_active": {
      "human_approval": false,
      "auto_execute": true,
      "scope": ["exact_owned_allowlist", "bounded_dast", "passive_vulnerability_checks", "rate_limited_security_validation"],
      "requirements": ["explicit_target_ownership", "exact_allowlist", "request_budget", "evidence", "rollback_or_no_persistent_effect"]
    },
    "tier_4_hard_boundary": {
      "human_approval": true,
      "auto_execute": false,
      "scope": ["secrets", "credential_policy", "authorization_root", "security_guard_disablement", "unbounded_external_writes", "destructive_external_actions", "protected_production_ref_direct_update"]
    }
  },
  "machine_approval": {
    "default": true,
    "required_evidence": ["tests", "build_or_runtime_evidence", "security_scan", "changed_file_inventory", "rollback_path_or_nonpersistent_effect"],
    "exact_head_audit": true,
    "all_required_checks_green": true,
    "random_approval": false,
    "fail_closed_on_missing_evidence": true
  },
  "trusted_resident_families": [
    "AI_FOUNDRY",
    "SENJU",
    "THE_WORLD",
    "GOD",
    "X",
    "META",
    "TOMOKI",
    "AGENT_FACTORY",
    "STANDMENT_SECURITY",
    "RED_TEAM",
    "RND",
    "CHILD_GUILD"
  ],
  "observation_roots": [
