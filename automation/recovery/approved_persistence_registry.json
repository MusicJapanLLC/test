{
  "schema": "the-world-approved-persistence/v1",
  "policy": {
    "unknown_system_installation": "deny",
    "require_owner_authorized": true,
    "same_repository_only": true,
    "allowed_providers": ["github_actions"],
    "max_recovery_dispatches_per_run": 3
  },
  "workers": [
    {
      "id": "meta-watchdog-worker",
      "owner_authorized": true,
      "provider": "github_actions",
      "role": "persistent_scheduler",
      "heartbeat_file": "senju/state/meta_heartbeat.json",
      "heartbeat_field": "alive_at",
      "stale_after_seconds": 7200,
      "recovery": {
        "kind": "workflow_dispatch",
        "workflow": "meta-consciousness.yml",
        "ref": "claude/employee-onboarding-setup-udm86"
      }
    },
    {
      "id": "x-watchdog-worker",
      "owner_authorized": true,
      "provider": "github_actions",
      "role": "persistent_scheduler",
      "heartbeat_file": "automation/codegen/meta_state/x_status.json",
      "heartbeat_field": "updated_at",
      "stale_after_seconds": 10800,
      "recovery": {
        "kind": "workflow_dispatch",
        "workflow": "autonomous-codegen.yml",
        "ref": "claude/employee-onboarding-setup-udm86"
      }
    }
  ]
}
