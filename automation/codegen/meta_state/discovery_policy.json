{
  "schema": "meta-discovery-policy/v5",
  "authorization_rule": {
    "inside_existing_owner_envelope": "discovered == authorized",
    "interesting_default": true,
    "target_addition": "automatic",
    "external_action_after_capability_lease": true,
    "shared_with": ["META", "X", "SENJU", "CHILD", "AI"]
  },
  "agent_goal": {
    "objective": "auto_authorize_discovery_inside_existing_owner_envelope",
    "applies_to": ["META", "X", "SENJU", "CHILD", "AI"],
    "candidate_stage_inside_owner_envelope": "disabled"
  },
  "trusted_roots": [
    "kabeya-authorized-test-range.onrender.com"
  ],
  "promotion": {
    "mode": "immediate_inside_existing_owner_envelope",
    "ttl_seconds": 21600,
    "allowed_methods": ["GET", "HEAD"],
    "credential_scope": "none",
    "allow_http": false,
    "allow_delete": false
  },
  "action_profiles": {
    "kabeya-authorized-test-range.onrender.com": {
      "owner_authorization": "explicit",
      "inherit_to_descendants": false,
      "capabilities": ["scan", "probe", "write", "mutation", "credentialed_action"],
      "credential_scope": "synthetic_test_bearer",
      "external_actions": {
        "write": [
          {
            "id": "synthetic-contact-write",
            "method": "POST",
            "path": "/contact/index.html",
            "content_type": "application/x-www-form-urlencoded",
            "body": "name=discovery-loop&message=synthetic-authorized-action"
          }
        ],
        "mutation": [
          {
            "id": "synthetic-record-create",
            "method": "PUT",
            "path": "/login-lab/synthetic-records/discovery-loop",
            "content_type": "application/json",
            "body": "{\"synthetic\":true,\"source\":\"discovery-authority-loop\"}"
          },
          {
            "id": "synthetic-record-update",
            "method": "PATCH",
            "path": "/login-lab/synthetic-records/discovery-loop",
            "content_type": "application/json",
            "body": "{\"synthetic\":true,\"note\":\"mutation-recovery-cycle\"}"
          },
          {
            "id": "synthetic-record-cleanup",
            "method": "DELETE",
            "path": "/login-lab/synthetic-records/discovery-loop",
            "content_type": "application/json",
            "body": null
          }
        ]
      }
    }
  },
  "credential_bound_mutation": {
    "enabled": true,
    "exact_explicit_owner_host_only": true,
    "credential_scope": "synthetic_test_bearer",
    "credential_resolution": "named_binding_to_named_environment_secret",
    "secret_persistence": false,
    "methods": ["POST", "PUT", "PATCH"],
    "agent_generated_payloads": "synthetic_only",
    "failure_retry": "payload_variant_then_same_host_alternate_path",
    "cross_host_failover": false,
    "authority_expansion_on_failure": false
  },
  "failure_recovery": {
    "transient_transport_failure": "learn -> alternate_transport_same_authority -> retry",
    "persist_route_learning": true,
    "rebuild_leases_after_retry": true,
    "rebuild_replicas_after_retry": true,
    "boundary_denial": "learn -> preserve_boundary -> no_retry",
    "authority_may_change_during_failover": false,
    "host_method_payload_may_change_during_failover": false
  },
  "untrusted_discovery": {
    "mode": "auto_authorize_inside_existing_owner_envelope",
    "inside_owner_envelope": "authorized_immediately",
    "outside_owner_envelope": "review_required",
    "new_trust_roots_from_discovery": false,
    "authority_inheritance": false,
    "credential_scope": "none"
  }
}
