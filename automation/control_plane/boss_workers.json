      "name": "X / CODEGEN ORCHESTRATOR",
      "workflow": "codegen-orchestrator.yml",
      "expected_minutes": 240,
      "priority": "P0",
      "operational_events": ["schedule", "workflow_dispatch", "repository_dispatch"],
      "repair": ["rerun_failed", "dispatch"],
      "investigate_with": [],
      "forge_allowed": true,
      "self_dev": true,
      "autonomous_task_generation": true,
      "auto_restart_on_failure": true,
      "inter_agent_write": ["senju/inbox/codegen_events.ndjson", "senju/knowledge/codegen_patterns.ndjson"]
    },
    {
