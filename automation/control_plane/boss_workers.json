      "repair": ["rerun_failed", "dispatch"],
      "investigate_with": [],
      "forge_allowed": true,
      "auto_restart_on_failure": true
    },
    {
      "id": "ai-foundry-executor",
      "name": "AI FOUNDRY / EXECUTOR",
