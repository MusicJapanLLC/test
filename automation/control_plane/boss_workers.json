      "expected_minutes": 15,
      "priority": "P0",
      "operational_events": ["schedule", "workflow_dispatch"],
      "repair": ["dispatch"],
      "investigate_with": [],
      "forge_allowed": true,
      "monitors": ["codegen-orchestrator", "senju-red-expedition", "tomoki-manager", "ai-foundry-executor"],
      "auto_restart_on_failure": true
    },
    {
      "id": "claude-auto-merge",
      "name": "CLAUDE / AUTO-MERGE",
      "workflow": "claude-auto-merge.yml",
      "expected_minutes": 5,
      "priority": "P0",
      "operational_events": ["pull_request", "workflow_run", "workflow_dispatch"],
      "repair": ["dispatch"],
      "investigate_with": [],
      "forge_allowed": true,
      "auto_merge_scope": "claude/*"
