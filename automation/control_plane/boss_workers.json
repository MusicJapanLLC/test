      "forge_allowed": true
    },
    {
      "id": "portfolio-evolution",
      "name": "PORTFOLIO / EVOLUTION",
      "workflow": "portfolio-evolution-daily.yml",
      "expected_minutes": 390,
      "priority": "P1",
      "operational_events": ["schedule", "workflow_dispatch"],
      "repair": ["rerun_failed", "dispatch"],
