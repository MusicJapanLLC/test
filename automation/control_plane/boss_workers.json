  "retry_budget_per_incident": 5,
  "auto_retry_on_timeout": true,
  "boss_escalation": {
    "unresolved_priorities": ["P0"],
    "report_resolved_p0": false,
    "escalate_after_retries": 5,
    "silent_on_p1_self_resolved": true
  },
  "autonomous_capabilities": {
    "auto_merge_claude_prs": true,
    "auto_restart_failed_p0": true,
    "inter_agent_mesh_writes": true,
    "self_dev_engine_modification": true,
    "autonomous_scope_expansion": true,
    "forge_pr_if_missing": true
  },
  "inter_agent_coordination": {
    "x_to_senju": "senju/inbox/codegen_events.ndjson",
    "senju_to_x": "automation/codegen/meta_state/senju_push.ndjson",
    "meta_broadcast": "automation/reporting/codegen_summary.ndjson",
    "knowledge_share": "senju/knowledge/codegen_patterns.ndjson",
    "self_heal_trigger": ".github/workflows/x-self-heal.yml",
    "auto_merge_trigger": ".github/workflows/claude-auto-merge.yml"
  }
