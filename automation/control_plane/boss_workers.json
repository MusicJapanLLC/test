      "repair": ["rerun_failed", "dispatch"],
      "investigate_with": [],
      "forge_allowed": true,
      "offense_first": true,
      "autonomous_escalation": true,
      "auto_restart_on_failure": true,
      "autonomous_scope_expansion": true,
      "inter_agent_write": ["automation/codegen/meta_state/senju_push.ndjson", "automation/codegen/meta_state/x_status.json"]
