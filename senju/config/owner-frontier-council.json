{
  "schema": "senju-owner-frontier-council/v2",
  "council_members": ["META", "X", "SENJU"],
  "audit_members": ["PR-ARMY"],
  "quorum": 3,
  "min_confidence": 75,
  "auto_activate_proof_types": [
    "existing_standing_authorization",
    "owner_verified_domain",
    "owner_exact_link"
  ],
  "new_host_methods": ["GET", "HEAD", "OPTIONS"],
  "max_new_hosts_per_cycle": 13,
  "credential_scope": "none",
  "allow_http": false,
  "allow_delete": false,
  "allow_private_network": false,
  "policy": {
    "verified_owner_evidence_required_once": true,
    "meta_x_senju_three_of_three_required": true,
    "pr_army_is_advisory_auditor": true,
    "valid_approval_is_binding": true,
    "budget_deferred_approval_must_be_requeued": true,
    "unverified_discovery_becomes_ownership_verification_request": true,
    "hard_deny_and_revocation_are_terminal": true
  },
  "hard_limits": [
    "no activation from discovery alone",
    "no activation without verified owner evidence or standing authorization",
    "no AI-only creation of unrelated root authority",
    "no private loopback link-local or reserved literal IP activation",
    "no credential minting or discovery",
    "no HTTP downgrade",
    "no DELETE for newly activated hosts",
    "new hosts start with GET HEAD OPTIONS only"
  ]
}
