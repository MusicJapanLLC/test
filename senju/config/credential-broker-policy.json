{
  "schema": "senju-credential-broker-policy/v3",
  "max_lease_seconds": 900,
  "max_delegation_seconds": 600,
  "renewal_margin_seconds": 180,
  "failure_cooldown_base_seconds": 30,
  "max_failure_cooldown_seconds": 900,
  "auto_select_from_authority": true,
  "systems": {
    "META": {
      "enabled": true,
      "default_capabilities": [
        "github_pr_automation",
        "approved_workflow_dispatch"
      ],
      "allowed_capabilities": [
        "github_pr_automation",
        "github_pr_review",
        "approved_workflow_dispatch"
      ]
    },
    "X": {
      "enabled": true,
      "default_capabilities": [
        "github_pr_automation",
        "approved_workflow_dispatch",
        "codegen_queue_write"
      ],
      "allowed_capabilities": [
        "github_pr_automation",
        "approved_workflow_dispatch",
        "codegen_queue_write"
      ]
    }
  },
  "capabilities": {
    "github_pr_automation": {
      "credential_ref": "runtime:github-actions-token",
      "provider": "github",
      "scopes": ["repo:read", "repo:write:pr"],
      "materialization": "runtime_only",
      "delegable": true,
      "priority": 10
    },
    "github_pr_review": {
      "credential_ref": "runtime:github-actions-token",
      "provider": "github",
      "scopes": ["repo:read", "repo:pr:review"],
      "materialization": "runtime_only",
      "delegable": false,
      "priority": 20
    },
    "approved_workflow_dispatch": {
      "credential_ref": "runtime:github-actions-token",
      "provider": "github",
      "scopes": ["repo:read", "workflow:dispatch:approved"],
      "materialization": "runtime_only",
      "delegable": true,
      "priority": 10
    },
    "codegen_queue_write": {
      "credential_ref": "internal:x-codegen-capability",
      "provider": "internal",
      "scopes": ["codegen:queue:write"],
      "materialization": "capability_handle",
      "delegable": false,
      "priority": 10
    }
  },
  "never_broker": [
    "credential_discovery",
    "raw_token_read",
    "administrator_credential",
    "oauth_scope_expand",
    "secret_write",
    "credential_exchange_external",
    "credential_export",
    "branch_protection_admin"
  ],
  "never_broker_scopes": [
    "repo:admin",
    "credentials:read",
    "credentials:write",
    "oauth:scope:expand",
    "secrets:read",
    "secrets:write",
    "security-policy:write",
    "branch-protection:write",
    "target-scope:expand"
  ],
  "never_delegate_scopes": [
    "repo:admin",
    "credentials:read",
    "credentials:write",
    "oauth:scope:expand",
    "secrets:read",
    "secrets:write",
    "security-policy:write",
    "branch-protection:write",
    "target-scope:expand"
  ]
}
