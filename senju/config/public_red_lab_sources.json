    "credential_scope": "none",
    "max_requests_per_cycle": 6,
    "shared_instance_rate_limit_rps": 1,
    "prohibited": [
      "denial_of_service",
      "resource_exhaustion",
      "destructive_state_change",
      "credential_reuse",
      "real_personal_data_exfiltration",
      "production_secret_exfiltration",
      "cross_host_pivoting",
      "social_engineering"
    ],
    "auto_admit_requires": [
      "https_target",
      "provider_policy_match",
      "operator_public_testing_evidence",
      "non_private_host"
    ]
  },
