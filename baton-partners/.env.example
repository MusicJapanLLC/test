# ─────────────────────────────────────────────────────────────
# Baton Partners 環境変数
# ローカルは .env.local に、本番は Vercel の Environment Variables に設定する
# VITE_ で始まる変数はビルド時にバンドルへ埋め込まれる（＝公開情報）。秘密の値は置かない。
# ─────────────────────────────────────────────────────────────

# 相談アンケートの送信先（gas/Code.gs をウェブアプリとしてデプロイしたURL）
# 空のままだと「デモモード」：送信ボタンは動くが、実際には送らない
VITE_GAS_ENDPOINT=

# 公開URL（canonical / og:url / sitemap.xml に使う）。Vercel上では未設定でも自動で入る
# 例: https://partners.music-japan.jp
VITE_SITE_URL=

# 1 にすると検索エンジンに公開する（noindex を外す）。デモの間は空のまま
BP_INDEX=
