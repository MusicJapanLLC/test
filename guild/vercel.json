{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/lantern-journey",
      "destination": "https://store.music-japan.com/games/",
      "permanent": false
    },
    {
      "source": "/lantern-journey/:path*",
      "destination": "https://store.music-japan.com/games/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mayor/pay/api/:fn",
      "destination": "/api/mayor/:fn"
    }
  ]
}
