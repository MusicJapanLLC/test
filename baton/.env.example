# ─────────────────────────────────────────────────────────────
# Baton 環境変数
# ローカルは .env.local に、本番は Vercel の Environment Variables に設定する
# VITE_ で始まる変数はビルド時にバンドルへ埋め込まれる（＝公開情報）。
# 秘密にしたい値はここに置かないこと。
# ─────────────────────────────────────────────────────────────

# アンケートの送信先。GAS を「ウェブアプリ」としてデプロイしたときのURL
# 例: https://script.google.com/macros/s/AKfycb...../exec
# 未設定のまま本番に出すと、送信時にエラー表示になる
VITE_GAS_ENDPOINT=

# Google アナリティクス 4 の測定ID（例: G-XXXXXXXXXX）
# 空のままなら GA4 のスクリプトは一切読み込まれない
VITE_GA4_ID=

# Meta ピクセルID（例: 1234567890123456）
# 空のままなら Meta のスクリプトは一切読み込まれない
# 送信完了時に Lead イベントを送る。これが広告最適化の軸になる
VITE_META_PIXEL_ID=

# 本番のドメイン（sitemap.xml と og:url に使う）
# Vercel 上では未設定でも VERCEL_PROJECT_PRODUCTION_URL から自動で入る。
# 独自ドメインを当てたときだけ、ここで上書きする
# 例: https://baton.music-japan.jp
VITE_SITE_URL=
