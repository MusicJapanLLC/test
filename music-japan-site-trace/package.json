  "private": true,
  "description": "Music Japan official site: NEEDLE DROP edition (next/) with the preserved 2026-09 snapshot (dist/) as rollback",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "preview": "node server.mjs --deploy",
    "test": "node --test tests/*.test.mjs",
