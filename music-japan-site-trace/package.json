    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "budoux": "^0.7.0",
    "gsap": "3.15.0",
    "lenis": "1.3.11",
    "three": "0.185.1"
  }
}
