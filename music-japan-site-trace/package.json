    "build:deploy": "node scripts/build-deploy.mjs",
    "build:legacy": "MJ_SITE=legacy node scripts/build-deploy.mjs",
    "dev": "vite next",
    "typecheck": "tsc -p next/tsconfig.json",
    "og": "node scripts/og-images.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.185.0",
